# Copier ce fichier en .env et renseigner les valeurs.

# Secret Auth.js (générer : `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`)
AUTH_SECRET=

# Identifiants OAuth « Application Web » (Google Cloud Console)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Base PostgreSQL (Neon en prod). Ex : postgresql://user:pwd@host/db?sslmode=require
DATABASE_URL=

# Adresses e-mail admin (séparées par des virgules)
ADMIN_EMAILS=matbelin5@gmail.com,lesfousduvolant69@gmail.com

# Clé de l'API d'intégration desktop (phase ultérieure)
INTEGRATION_API_KEY=

# Stockage des images d'en-tête (Vercel Blob) — créer un store Blob puis copier son jeton
BLOB_READ_WRITE_TOKEN=

# Envoi des e-mails de vérification d'adresse (SMTP Gmail du club)
# GMAIL_APP_PASSWORD = « mot de passe d'application » Google (16 caractères), PAS le mot de passe du compte.
# Coller les 16 caractères seuls, sans chevrons ni guillemets (les espaces des groupes de 4 sont tolérés).
GMAIL_USER=lesfousduvolant69@gmail.com
GMAIL_APP_PASSWORD=
MAIL_FROM=Club de badminton <lesfousduvolant69@gmail.com>
