# Copier ce fichier en .env et renseigner les valeurs.

# Secret Auth.js (générer : `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`)
AUTH_SECRET=

# Identifiants OAuth « Application Web » (Google Cloud Console)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Base PostgreSQL (Neon en prod). Ex : postgresql://user:pwd@host/db?sslmode=require
DATABASE_URL=

# Adresses e-mail admin (séparées par des virgules)
ADMIN_EMAILS=matbelin5@gmail.com,lesfousduvolant69@gmail.com

# Clé de l'API d'intégration desktop (phase ultérieure)
INTEGRATION_API_KEY=

# Stockage des images d'en-tête (Vercel Blob) — créer un store Blob puis copier son jeton
BLOB_READ_WRITE_TOKEN=

# Envoi des e-mails (vérification d'adresse, confirmation d'inscription) — deux modes.
#
# Mode 1 (RECOMMANDÉ) : service d'e-mail dédié (Brevo, Mailjet…). Meilleure délivrabilité,
# notamment vers laposte.net et SFR/numericable qui filtrent le transactionnel des @gmail.
# Renseigner SMTP_HOST active ce mode (le repli Gmail est alors ignoré).
#   Brevo   : SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<login SMTP>  SMTP_PASS=<clé SMTP>
#   Mailjet : SMTP_HOST=in-v3.mailjet.com     SMTP_PORT=587  SMTP_USER=<API key>     SMTP_PASS=<secret key>
# SMTP_PORT (587 par défaut ; 465 = chiffré d'emblée) et SMTP_SECURE ("true"/"false") sont facultatifs.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=
#
# Mode 2 (repli) : compte Gmail du club, utilisé si SMTP_HOST n'est PAS défini.
# GMAIL_APP_PASSWORD = « mot de passe d'application » Google (16 caractères), PAS le mot de passe du compte.
# Coller les 16 caractères seuls, sans chevrons ni guillemets (les espaces des groupes de 4 sont tolérés).
GMAIL_USER=lesfousduvolant69@gmail.com
GMAIL_APP_PASSWORD=
#
# Expéditeur affiché (facultatif, les deux modes). Avec un service dédié, VÉRIFIER cette adresse dans son tableau de bord.
MAIL_FROM=Club de badminton <lesfousduvolant69@gmail.com>
